# ─────────────────────────────────────────────────────────────
# Launchpad environment configuration
#
# Copy this file to `.env.local` and fill in the values from YOUR
# OWN Supabase project (Supabase Dashboard > Project Settings).
#
# Never commit `.env.local` or any file containing real keys.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL
# Supabase Dashboard > Project Settings > General > Project URL
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Your Supabase publishable key
# Supabase Dashboard > Project Settings > API > Publishable key
# Starts with sb_publishable_. Safe for browser use.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────
# SECURITY WARNING
#
# Vite embeds EVERY VITE_ variable into the client bundle at
# build time. Never place a service_role key, an sb_secret_ key,
# a database password, or any other backend secret in a VITE_
# variable — it would be exposed to anyone who loads your site.
# The frontend needs only the two public variables above.
# ─────────────────────────────────────────────────────────────
